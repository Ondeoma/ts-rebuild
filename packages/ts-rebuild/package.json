{
  "name": "@ondeoma/ts-rebuild",
  "version": "0.1.3",
  "description": "Transformer to update type-checker after other transformers.",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepack": "shx cp ../../README.md . && shx cp ../../LICENSE .",
    "test": "vitest run",
    "eslint": "eslint",
    "eslint:fix": "eslint --fix",
    "prettier": "prettier src --check",
    "prettier:fix": "prettier src --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ondeoma/ts-rebuild.git"
  },
  "author": "hyranno",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Ondeoma/ts-rebuild/issues"
  },
  "homepage": "https://github.com/Ondeoma/ts-rebuild#readme",
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "ts-patch": "^3.3.0",
    "vitest": "^4.0.16"
  },
  "dependencies": {
    "shx": "^0.4.0",
    "tsconfig-paths": "^4.2.0"
  }
}
